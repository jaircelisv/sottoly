{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/comandos.sh" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontera.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secretos.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/anotar-medicion.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/medir.sh" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node gate/verificar.mjs)",
      "WebSearch",
      "WebFetch",
      "Bash(git diff *)",
      "Bash(node *)",
      "mcp__linear-server__get_workspace",
      "mcp__linear-server__list_teams",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__get_project",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__save_project",
      "mcp__linear-server__save_issue",
      "mcp__linear-server__save_comment",
      "mcp__linear-server__save_status_update"
    ]
  }
}
