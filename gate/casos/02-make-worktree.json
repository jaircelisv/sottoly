        "binarios_copiados": true
      }
    },
    {
      "nombre": "sin el archivo privado no crea nada y el mensaje nombra ~/.sottoly/CLAUDE.private.md",
      "entrada": [{ "nombre": "prueba", "con_archivo_privado": false, "con_binarios": true }],
      "esperado": { "ok": false, "menciona_archivo_privado": true, "menciona_name": false }
    },
    {
      "nombre": "sin NAME no crea nada y el mensaje pide NAME",
      "entrada": [{ "nombre": "", "con_archivo_privado": true, "con_binarios": true }],
      "esperado": { "ok": false, "menciona_archivo_privado": false, "menciona_name": true }
    }
  ]
