      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "suggestion_delta"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "role_label": {
            "type": "string",
            "minLength": 1
          },
          "persona": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id",
          "role",
          "role_label",
          "persona",
