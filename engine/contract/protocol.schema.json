{
  "$comment": "Generado desde engine/src/protocol.ts con `bun src/contract.ts --write`. No editar a mano.",
  "inbound": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "segment"
          },
          "speaker": {
            "type": "string",
            "enum": [
              "user",
              "counterpart",
              "mixed"
            ]
          },
          "text": {
            "type": "string"
          },
          "t0": {
            "type": "number",
            "minimum": 0
          },
          "t1": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "speaker",
          "text",
          "t0",
          "t1"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "session"
          },
          "event": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "review"
            ]
          }
        },
        "required": [
          "type",
          "event"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "clock"
          },
          "t": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "t"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "chat"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reply_to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id",
          "role",
          "text"
        ],
        "additionalProperties": false
      }
    ]
  },
  "outbound": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
