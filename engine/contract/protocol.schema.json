          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id",
          "role",
          "text"
        ],
        "additionalProperties": false
